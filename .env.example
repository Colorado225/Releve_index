# Variables d'environnement pour Vercel
# Copiez ce fichier vers .env.local pour le développement local

# URL de l'API (utilisée automatiquement par le frontend)
# En production sur Vercel, cette variable n'est pas nécessaire car le frontend utilise le chemin relatif /api/
# VITE_API_URL=http://localhost:8000

# Configuration pour le build Vite
VITE_APP_NAME=Relevé Index
VITE_APP_VERSION=1.0.0